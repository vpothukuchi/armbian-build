### Specific to building Armbian ###
/.vagrant/
ubuntu-*-cloudimg-console.log

### to ignore changes in a working copy
.ignore_changes

### compile configurations added by users
/config-*.conf
### but not default (supplied) files
!/config-docker.conf
!/config-vagrant.conf

### output directories
/.tmp/
/output/
/cache/
/*userpatches*/
/userpatches

### General annoyances ###
.DS_Store
*~
*.swp
/__pycache__/*

# Mainly generated by merge tools like 'meld'
*.orig

# Root-level Dockerfile and .dockerignore are generated by docker.sh
/Dockerfile
/.dockerignore

# EdgeAI package build artifacts
packages/edgeai/**/*.debhelper.log

# Local build notes (untracked)
packages/edgeai/BUILD_TIMES.md
