#!/bin/sh
set -e

FW_DIR=/usr/lib/firmware/vision_apps_evm

update-alternatives --remove j784s4-main-r5f0_0-fw ${FW_DIR}/vx_app_rtos_linux_mcu2_0.out
update-alternatives --remove j784s4-main-r5f0_1-fw ${FW_DIR}/vx_app_rtos_linux_mcu2_1.out
update-alternatives --remove j784s4-main-r5f1_0-fw ${FW_DIR}/vx_app_rtos_linux_mcu3_0.out
update-alternatives --remove j784s4-main-r5f1_1-fw ${FW_DIR}/vx_app_rtos_linux_mcu3_1.out
update-alternatives --remove j784s4-main-r5f2_0-fw ${FW_DIR}/vx_app_rtos_linux_mcu4_0.out
update-alternatives --remove j784s4-main-r5f2_1-fw ${FW_DIR}/vx_app_rtos_linux_mcu4_1.out
update-alternatives --remove j784s4-c71_0-fw       ${FW_DIR}/vx_app_rtos_linux_c7x_1.out
update-alternatives --remove j784s4-c71_1-fw       ${FW_DIR}/vx_app_rtos_linux_c7x_2.out
update-alternatives --remove j784s4-c71_2-fw       ${FW_DIR}/vx_app_rtos_linux_c7x_3.out
update-alternatives --remove j784s4-c71_3-fw       ${FW_DIR}/vx_app_rtos_linux_c7x_4.out

update-alternatives --remove j784s4-main-r5f0_0-fw-sec ${FW_DIR}/vx_app_rtos_linux_mcu2_0.out.signed
update-alternatives --remove j784s4-main-r5f0_1-fw-sec ${FW_DIR}/vx_app_rtos_linux_mcu2_1.out.signed
update-alternatives --remove j784s4-main-r5f1_0-fw-sec ${FW_DIR}/vx_app_rtos_linux_mcu3_0.out.signed
update-alternatives --remove j784s4-main-r5f1_1-fw-sec ${FW_DIR}/vx_app_rtos_linux_mcu3_1.out.signed
update-alternatives --remove j784s4-main-r5f2_0-fw-sec ${FW_DIR}/vx_app_rtos_linux_mcu4_0.out.signed
update-alternatives --remove j784s4-main-r5f2_1-fw-sec ${FW_DIR}/vx_app_rtos_linux_mcu4_1.out.signed
update-alternatives --remove j784s4-c71_0-fw-sec       ${FW_DIR}/vx_app_rtos_linux_c7x_1.out.signed
update-alternatives --remove j784s4-c71_1-fw-sec       ${FW_DIR}/vx_app_rtos_linux_c7x_2.out.signed
update-alternatives --remove j784s4-c71_2-fw-sec       ${FW_DIR}/vx_app_rtos_linux_c7x_3.out.signed
update-alternatives --remove j784s4-c71_3-fw-sec       ${FW_DIR}/vx_app_rtos_linux_c7x_4.out.signed

#DEBHELPER#
