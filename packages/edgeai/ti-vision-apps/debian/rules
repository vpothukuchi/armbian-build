#!/usr/bin/make -f
# debian/rules for ti-vision-apps
# All artifacts are prebuilt; this rule installs from the prepared staging area.

%:
	dh $@

override_dh_auto_configure:
	# Nothing to configure — prebuilt binaries only

override_dh_auto_build:
	# Nothing to build — prebuilt binaries only

override_dh_auto_install:
	# --- libtivision-apps11.2.0: shared library ---
	install -d debian/libtivision-apps11.2.0/usr/lib
	cp staging/runtime/usr/lib/libtivision_apps.so.11.2.0 \
	    debian/libtivision-apps11.2.0/usr/lib/

	# --- libtivision-apps-dev: unversioned symlink + headers ---
	install -d debian/libtivision-apps-dev/usr/lib
	install -d debian/libtivision-apps-dev/usr/include
	ln -sf libtivision_apps.so.11.2.0 \
	    debian/libtivision-apps-dev/usr/lib/libtivision_apps.so
	cp -a staging/dev/usr/include/. debian/libtivision-apps-dev/usr/include/

	# --- ti-vision-apps-data: opt/imaging DCC bins + opt/vision_apps ---
	# vx_app_*.out binaries are built by build-from-source.sh and staged
	# into staging/runtime/opt/vision_apps/ by the SDK's linux_fs_stage
	# target — they end up at /opt/vision_apps/ on the target.
	install -d debian/ti-vision-apps-data/opt
	cp -a staging/runtime/opt/imaging debian/ti-vision-apps-data/opt/
	cp -a staging/runtime/opt/vision_apps debian/ti-vision-apps-data/opt/

override_dh_strip:
	# Prebuilt binaries — do not strip (already stripped by Yocto)
	dh_strip --no-automatic-dbgsym

override_dh_shlibdeps:
	# Skip shlibdeps: prebuilt arm64 binaries on x86_64 host.
	# Runtime deps declared explicitly in debian/control.
